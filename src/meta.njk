---
pagination:
  data: files
  size: 1
  alias: file
files: [sitemap, robots, search]
permalink: "{{ {'sitemap': '/sitemap.xml', 'robots': '/robots.txt', 'search': '/search-index.json'}[file] }}"
eleventyExcludeFromCollections: true
---
{%- if file == 'sitemap' -%}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for url in ['/', '/arsiv/', '/kategoriler/', '/hakkinda/'] %}
  <url><loc>{{ site.url }}{{ url }}</loc></url>
{%- endfor %}
{%- for p in collections.posts %}
  <url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ p.date | iso }}</lastmod></url>
{%- endfor %}
{%- for t in collections.tagList %}
  <url><loc>{{ site.url }}/etiket/{{ t.slug }}/</loc></url>
{%- endfor %}
{%- for c in collections.categoryList %}
  <url><loc>{{ site.url }}/kategori/{{ c.slug }}/</loc></url>
{%- endfor %}
</urlset>
{%- elif file == 'robots' -%}
User-agent: *
Allow: /

Sitemap: {{ site.url }}/sitemap.xml
{%- else -%}
{{ collections.posts | reverse | searchIndex | safe }}
{%- endif %}
