{% macro icon(name, size=18) -%}
{%- set paths = {
  github: '<path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/>',
  x: '<path d="M4 4l16 16M20 4 4 20"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
  rss: '<path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20 15.3 15.3 0 0 1 0-20"/>'
} -%}
<svg width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ paths[name] | safe }}</svg>
{%- endmacro %}

{# Kapak: yazının görseli varsa o, yoksa başlıktan üretilen desen #}
{% macro cover(post, eager=false) -%}
<div class="cover">
  {%- if post.data.image %}
  <img src="{{ post.data.image }}" alt="" width="1200" height="630" decoding="async"{% if not eager %} loading="lazy"{% endif %}>
  {%- else %}
  {{ post.data.title | cover | safe }}
  {%- endif %}
</div>
{%- endmacro %}

{% macro card(post, featured=false) -%}
<article class="card{% if featured %} card-featured{% endif %}">
  <div class="card-media">{{ cover(post, featured) }}</div>
  <div class="card-body">
    <a class="card-cat" href="/kategori/{{ post.data.category | slug }}/">{{ post.data.category }}</a>
    <h3 class="card-title"><a href="{{ post.url }}">{{ post.data.title }}{% if post.data.draft %} <span class="draft">taslak</span>{% endif %}</a></h3>
    {% if post.data.description %}<p class="card-desc">{{ post.data.description }}</p>{% endif %}
    <div class="card-meta">
      <time datetime="{{ post.date | iso }}">{{ post.date | date }}</time>
      <span>{{ post.content | readingTime }} dk okuma</span>
      {% if post.data.difficulty %}<span class="stamp stamp-{{ post.data.difficulty | slug }}">{{ post.data.difficulty }}</span>{% endif %}
    </div>
  </div>
</article>
{%- endmacro %}
